# Used for metadata, Open Graph tags and the sitemap. Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI extraction. The app works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Production persistence target (not required for the local demo yet)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
